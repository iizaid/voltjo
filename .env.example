# Supabase public project configuration.
# Copy this file to .env.local and fill the values from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin (no trailing slash), e.g. https://voltjo.com
# Used server-side to build the password-reset redirect (lib/auth/actions.ts getRequestOrigin).
# In production this should be your real HTTPS domain; for local dev use http://localhost:3000.
# Safe to expose (NEXT_PUBLIC_*): it is only the public origin, not a secret.
NEXT_PUBLIC_SITE_URL=

# Never place a Supabase service role key in client code or NEXT_PUBLIC_* variables.
# Service role keys bypass RLS and must stay server-only in controlled backend jobs.
# Required only for self-service account deletion. Configure this as a
# Cloudflare Runtime secret, not as a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth Provider Note:
# Do not add Google or GitHub OAuth secrets to this file or repository.
# Configure OAuth credentials directly inside your Supabase Auth dashboard.
# Add these redirect URLs in Supabase Dashboard -> Authentication -> URL Configuration:
# http://localhost:3000/auth/callback (for local dev)
# http://localhost:3000/auth/update-password (for local dev)
# https://[your-staging-domain]/auth/callback (for staging)
# https://[your-staging-domain]/auth/update-password (for staging)
# https://[your-production-domain]/auth/callback (for production)
# https://[your-production-domain]/auth/update-password (for production)

# Optional Auth CAPTCHA / Turnstile:
# Add this public site key only if the app renders a Turnstile widget.
# The Turnstile secret key belongs in Supabase Auth CAPTCHA settings, not here.
# Never add TURNSTILE_SECRET_KEY to NEXT_PUBLIC_* or to this repo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# AI chat server configuration.
# Keep ALL AI keys server-only. Never expose them through NEXT_PUBLIC_* variables.
#
# Primary provider (default: gemini). Must have its key set or requests fail fast.
AI_PROVIDER=gemini
#
# REQUIRED for the default Gemini provider. Get one from https://aistudio.google.com/apikey
# (standard keys look like "AIza..."). Configure as a Cloudflare Runtime secret in prod.
GOOGLE_AI_API_KEY=
#
# OPTIONAL additional providers — set a key to enable as fallback (registry-gated).
OPENAI_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
#
# OPTIONAL tuning (sane defaults applied when unset):
# AI_MODEL=            # override the provider's default model id
# AI_TIMEOUT_MS=30000  # per-request upstream deadline
# AI_MAX_RETRIES=2     # retries on retryable upstream errors

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
